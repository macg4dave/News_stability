FROM golang:1.26-alpine@sha256:30b1e546a9c7fa3b747c2bdba3a0c7bdf3a02ebb4c5b8405d2f948d7e8aac4ec AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
RUN CGO_ENABLED=0 go build -trimpath -o /out/reader ./cmd/reader

FROM build AS test
RUN apk add --no-cache gcc musl-dev
RUN CGO_ENABLED=1 go test -race ./...

FROM alpine:3.23@sha256:469c9ea410b9215eaee7976ba6c0639039b444be8e5d638f7abbada189971eb2
RUN apk add --no-cache ca-certificates
COPY --from=build /out/reader /usr/local/bin/reader
COPY licenses/ /usr/share/licenses/news-stability/licenses/
COPY THIRD_PARTY_NOTICES.md /usr/share/licenses/news-stability/THIRD_PARTY_NOTICES.md
USER 65532:65532
ENV HTTP_ADDR=:8090
EXPOSE 8090
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=5 CMD wget -q -O /dev/null http://127.0.0.1:8090/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/reader"]
