{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "MicroPython (Emulator)",
            "type": "micropython-emulator",
            "request": "launch",
            "program": "${file}"
        },
        {
            "name": "Go: reader",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}/cmd/reader",
            "cwd": "${workspaceFolder}",
            "env": {
                "HTTP_ADDR": "127.0.0.1:8090"
            },
            "showLog": true
        },
        {
            "name": "Go: current package tests",
            "type": "go",
            "request": "launch",
            "mode": "test",
            "program": "${fileDirname}",
            "cwd": "${workspaceFolder}"
        }
    ]
}