server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'none'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /api/healthz {
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $reader_origin http://app:8090;
        proxy_pass $reader_origin/healthz;
        proxy_connect_timeout 5s;
        proxy_read_timeout 5s;
    }

    # Explicit Go reader endpoints own upstream credentials and session cookies.
    location /api/ {
        access_log off;
        client_max_body_size 16k;
        resolver 127.0.0.11 valid=30s ipv6=off;
        set $reader_origin http://app:8090;
        proxy_pass $reader_origin$request_uri;
        proxy_http_version 1.1;
        proxy_connect_timeout 5s;
        proxy_read_timeout 35s;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
